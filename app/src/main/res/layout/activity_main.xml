<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7FC"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="FORMULIR PROFIL"
            android:textSize="25sp"
            android:textStyle="bold"
            android:textColor="#1D3557"
            android:gravity="center"
            android:padding="16dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nama Lengkap"
            android:textColor="#222222"
            android:textStyle="bold"/>

        <EditText
            android:id="@+id/etNama"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Masukkan nama lengkap"
            android:inputType="textPersonName"
            android:padding="12dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Email"
            android:textColor="#222222"
            android:textStyle="bold"
            android:layout_marginTop="12dp"/>

        <EditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Masukkan email"
            android:inputType="textEmailAddress"
            android:padding="12dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tahun Lahir"
            android:textColor="#222222"
            android:textStyle="bold"
            android:layout_marginTop="12dp"/>

        <EditText
            android:id="@+id/etTahunLahir"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Contoh: 2005"
            android:inputType="number"
            android:padding="12dp"/>

        <Button
            android:id="@+id/btnSimpan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SIMPAN"
            android:layout_marginTop="20dp"/>

        <Button
            android:id="@+id/btnBatal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="BATAL"/>

        <Button
            android:id="@+id/btnHapusData"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="HAPUS DATA TERSIMPAN"/>

        <Button
            android:id="@+id/btnLihatPengguna"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="LIHAT PENGGUNA"
            android:layout_marginTop="12dp"/>

    </LinearLayout>

</ScrollView>